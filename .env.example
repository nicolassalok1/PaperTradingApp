# PaperTradingApp — local configuration template.
# Copy to `.env` and fill in your own values. NEVER commit the real `.env`
# (it is gitignored). In production, inject these via environment variables or
# Streamlit secrets (see streamlit_app.py / app/utils/secrets.py).

# --- Alpaca (PAPER trading by default — keep the paper endpoint) ---
APCA_API_KEY_ID=your-alpaca-key-id
APCA_API_SECRET_KEY=your-alpaca-secret-key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- OpenAI (optional — only needed for the ChatGPT assistant / bots) ---
OPENAI_API_KEY=your-openai-api-key
